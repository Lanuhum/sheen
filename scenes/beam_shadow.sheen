# Sheen: тени внутри объёма луча (beam)
# Прожектор светит через тёмный зал: щит у самой лампы и колонна в луче
# вырезают из конуса тёмные полосы. Без теневых лучей в объёме перекрытие
# гасит только собственный пиксель, а поток света остаётся сплошным.
resolution 640 480 4 /tmp/beam.png
camera 0 1.9 6.5   0 -0.20 -1

material 0.15 0.15 0.17  0.1 16 0.10   # пол
material 0.62 0.22 0.16  0.2 32 0.10   # щит и колонна

plane 0 1 0 0 0
cube -0.6 2.5 3.2 0.40 1   # щит у лампы
cube  0.0 0.8 0.0 0.30 1   # колонна в луче

spot -1.0 3.4 4.2   0.8 -2.4 -4.2   1.0 0.92 0.78   500  0.80 0.35 0.12  0.9
