# Sheen: каустика от стеклянного шара (фотонная карта)
# Свет проходит сквозь шар и собирается в пятно на полу.
# photons — эмиссия на источник, photon_cell — ячейка карты,
# caustics — сила вклада (0 — выключено, нулевая стоимость).
resolution 320 240 1 /tmp/caustics.png
camera 0 1.2 4.0   0 -0.1 -1

material 0.2 0.2 0.22  0.1 16 0.1      # пол
material 0.9 0.9 0.9   0.5 64 0.05     # стекло

plane 0 1 0 0 0
sphere 0 1.0 0 0.5 1
glass 1 1.0 1.45

spot 0 3.0 2.0   0 -1 -0.8   1 1 1   200  0.5 0.2 0.05  0
photons 20000
photon_cell 0.25
caustics 0.3
