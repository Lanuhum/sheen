# Sheen: CSG-коробка с проёмом (differencA(куб, union(полость, дверь)))
# Камера снаружи — видно полую коробку с квадратным проёмом в стене.
resolution 640 480 4 /tmp/csg_demo.png
camera 0 0.2 4.0   0 0 -1

material 0.75 0.72 0.68  0.2 32 0.15  # стены
material 0.9 0.88 0.85  0.1 8 0.2     # пол (плоскость)

se 0 0 0  1.2 1.0 1.2  12 0   # внешний куб (A)
se 0 0 0  1.05 0.85 1.05  12 0 # полость (B)
se 0 -0.35 -1.125  0.55 0.75 0.25  12 0  # дверь-проём в передней стенке (z=-1.2..-1.05)

csg_begin 2
    csg_leaf 1 0
    csg_begin 0
        csg_leaf 1 1
        csg_leaf 1 2
    csg_end
csg_end

plane 0 1 0 0 1   # пол под коробкой

light -0.4 -0.7 -0.5  1 1 1 1.0