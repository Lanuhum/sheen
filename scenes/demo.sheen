# Sheen: голова с волосами
# Строка без # — выполняется. Строка с # — план на следующие шаги.
# Команды: resolution, camera, material, sphere, grid, plane, cube, triangle,
#          sweep / sweep_smooth, hair, light

resolution 800 600 4 scene_output.png
camera 0 1.55 2.6   0 0 -1

material 0.75 0.6 0.5   0.25 24 0.15                              # кожа
# волосы: aniso shift spec_r exp_r spec_t exp_t backlight
material 0.35 0.22 0.12 0.6  128 0.10   1.0 0.12 1.2 12 0.5 6 0.5  # тёмные волосы
material 0.5 0.5 0.5    0.1   8 0.2                               # пол

sphere 0 1.6 0  0.55 0
hair   0 1.6 0  0.55 1500 12 12345 1
plane 0 1 0 0 2

light -0.6 -0.8 -0.5  1 1 1 0.9

# --- план ---
# hair 0 1.6 0 0.55 3000 14 777 1      больше прядей, гуще
# sweep_smooth 1 2 ...                отдельные локоны поверх причёски
# volume 0 1.6 0 0.55                 волюметрический ореол
