# Sheen: видимые источники света (emission)
# Люстра светится сама (не только освещает) и видна в полу-зеркале пола.
# Зал тёмный: видно именно тела ламп, а не засветку.
resolution 640 480 4 /tmp/emission.png
camera 0 2.2 7.5   0 -0.05 -1

material 0.10 0.10 0.12  0.15 24 0.05   # тёмный пол
material 0.50 0.50 0.52  0.10 16 0.05   # металл люстры
material 0.05 0.05 0.05  0.00  8 0.02   # тело лампы (светится сама)

plane 0 1 0 0 0
reflect 0 0.35

# задняя стена зала
se 0 2.6 -4.0   5.0 3.0 0.10  12 0

# перекладина люстры
se 0 3.30 0   1.00 0.06 0.06  8 1
# три шара-лампы
sphere -0.80 3.20 0 0.22 2
sphere  0.00 3.35 0 0.22 2
sphere  0.80 3.20 0 0.22 2

# тёплое свечение: цвет и сила (линейно, до sRGB)
emit 2 1.0 0.80 0.45 3.0

# слабый заполняющий свет, чтобы зал не был абсолютно чёрным
point 0 2.2 3.0   0.5 0.55 0.7   25  0.05
