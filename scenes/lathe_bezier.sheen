# Sheen: Lathe с bezier_spline — плавная ваза (профиль y,radius из кубических Безье)
# Контрольные точки профиля (y, radius) идут группами по 4 (один кубик на группу),
# кривая непрерывна (точка 3 группы = точка 0 следующей). Ось вращения — Y.
resolution 500 400 4 /tmp/lathe_bezier.png
camera 0 0.9 3.6   0 0.2 -1

material 0.3 0.55 0.75  0.3 32 0.12    # глазурованная синяя ваза
material 0.5 0.5 0.5    0.1 8 0.2      # пол

# lathe_bezier cx cy cz mat subdiv  n  y1 r1 y2 r2 ...  (y, radius)
# 3 кубика: широкое основание, пузатый корпус, сужающееся горлышко.
lathe_bezier 0 0 0 0 16  12  0.00 0.00 0.15 0.55 0.40 0.55 0.60 0.35  0.60 0.35 0.80 0.75 1.00 0.40 1.10 0.20  1.10 0.20 1.15 0.22 1.20 0.10 1.30 0.10

plane 0 1 0 0 1

light -0.5 -0.7 -0.6  1 1 1 1.0