# Sheen: три типа источников — солнце, прожектор и софит (area).
resolution 640 480 8 /tmp/lights_demo.png
camera 0 2.4 6.5   0 -0.2 -1

material 0.55 0.55 0.58  0.2 24 0.12   # стена/сцена
material 0.75 0.65 0.5   0.15 16 0.12  # пол

plane 0 1 0 0 2

# сцена-коробка: пол уже есть, стена за танцором
se 0 1.5 -2.2  3.0 1.5 0.15  12 0

# прожектор сверху-слева, конус 30°, мягкий край
spot -2.2 3.4 1.6   0.55 -1 -0.35   1.0 0.92 0.8   900   0.52 0.35 0.18  0.12
# второй прожектор справа, холодный
spot  2.4 3.6 1.2  -0.5 -1 -0.2     0.7 0.8 1.0    700   0.44 0.25 0.15  0.08

# софит над сценой (прямоугольник в XZ, светит вниз)
area 0 3.8 0.4   2.4 1.2   1.0 0.95 0.85   120

# общий заполняющий свет
light -0.3 -0.8 -0.4   1 1 1   0.25
