# Sheen: комната с окном и рассеивающей средой (по мотивам POV-Ray 2.3.7.6)
# Луч солнца проходит через проём, среда делает его видимым.
resolution 640 480 8 /tmp/media_room.png
camera 0 1.7 6.0   0 -0.05 -1

material 0.45 0.45 0.45  0.1 16 0.15  # стена
material 0.5 0.5 0.5  0.1 8 0.2     # пол

plane 0 1 0 0 1

# Стена с окном 2x2: difference(стена, проём) union переплёт.
# se_csg не рисуется сам по себе, поэтому проём остаётся проёмом,
# а стойки дают тени и делят свет на четыре секции.
se_csg 0 1.5 0    3.0 1.5 0.15   12 0    # 0: стена
se_csg 0 1.7 0    0.9 0.7 0.40   12 0    # 1: проём
se_csg 0 1.7 0    0.05 0.7 0.16  12 0    # 2: вертикальная стойка
se_csg 0 1.7 0    0.9 0.05 0.16  12 0    # 3: горизонтальная стойка

csg_begin 0                       # union
    csg_begin 2                   # difference(стена, проём)
        csg_leaf 1 0
        csg_leaf 1 1
    csg_end
    csg_begin 0                   # union(стойки)
        csg_leaf 1 2
        csg_leaf 1 3
    csg_end
csg_end

# Среда в объёме комнаты перед стеной (бокс минимальный — цена по шагам)
reflect 1 0.55

media 0 1.5 1.6   2.6 1.5 1.6   0.30 0.30 0.30   0.01   64

# Солнце снаружи, светит через окно
light 0.15 -0.45 0.9   1 1 0.95   2.0
sun_angle 0.0087   # полградуса: мягкая граница тени
# Заполняющий свет изнутри; со средой не взаимодействует
fill_light -0.2 -0.5 -0.85   0.8 0.85 1.0   0.06
