# Sheen: Prism с bezier_spline — плавная капля (XZ-контур из кубических Безье)
# Контрольные точки контура идут группами по 4 (один кубик на группу),
# последняя группа замыкается на первую точку (контур закрыт).
resolution 640 480 4 /tmp/prism_bezier.png
camera 2.2 2.6 2.6   0 -0.4 -1

material 0.85 0.2 0.25  0.35 40 0.12   # красная плавная колонна
material 0.5 0.5 0.5    0.1 8 0.2      # пол

# prism_bezier cx cy cz y1 y2 sweep mat subdiv  n  x1 z1 x2 z2 ...
# Замкнутый контур-капля: G1 низ->верх слева, G2 острая вершина, G3 низ справа.
prism_bezier 0 0 0  0 0.7 0 0 12  12  0.0 -1.0 -0.8 -0.6 -1.0 0.1 -0.6 0.5  -0.6 0.5 0.0 1.2 0.0 1.2 0.6 0.5  0.6 0.5 1.0 0.1 0.8 -0.6 0.0 -1.0

plane 0 1 0 0 1

light -0.5 -0.7 -0.6  1 1 1 1.0