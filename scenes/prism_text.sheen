# Sheen: 3D-текст из призм — буквы H и F на полу
# Профиль буквы в XZ, экструзия по Y = высота буквы (0..0.3).
# Каждая буква — одна призма из под-контуров (стойки/перекладины),
# контуры закрываются повтором первой точки.
resolution 640 480 4 /tmp/prism_text.png
camera 0 3.2 3.0   0 -0.85 -1

material 0.9 0.72 0.3  0.35 48 0.1   # золотой текст
material 0.5 0.5 0.5   0.1 8 0.2     # пол

# prism cx cy cz y1 y2 sweep mat  n  x1 z1 x2 z2 ... (XZ-контуры, все в одной строке)
# H: левая стойка, правая стойка, перекладина
prism 0 0 0  0 0.3 0 0  15  -1 0 -0.8 0 -0.8 0.3 -1 0.3 -1 0  0.8 0 1 0 1 0.3 0.8 0.3 0.8 0  -0.8 0.1 0.8 0.1 0.8 0.2 -0.8 0.2 -0.8 0.1

# F: стойка, верхняя перекладина, средняя перекладина (center x=+2.6)
prism 2.6 0 0  0 0.3 0 0  15  -1 0 -0.8 0 -0.8 0.3 -1 0.3 -1 0   -0.8 0.03 0.6 0.03 0.6 0.15 -0.8 0.15 -0.8 0.03  -0.8 0.2 0.2 0.2 0.2 0.3 -0.8 0.3 -0.8 0.2

plane 0 1 0 0 1

light -0.5 -0.8 -0.5  1 1 1 1.0