# Sheen: суперэллипсоиды — от сферы к кубу с фасками
resolution 700 400 4 /tmp/se_demo.png
camera 0 1.4 4.5   0 0 -1

material 0.8 0.25 0.2  0.35 64 0.15   # красный (эллипсоид n=2)
material 0.25 0.6 0.3  0.35 64 0.15  # зелёный (n=6, фаски)
material 0.3 0.35 0.85 0.35 64 0.15  # синий (n=12, почти куб)
material 0.6 0.6 0.6  0.1  8 0.2     # пол

# se cx cy cz a b c n mat
se -1.6 0.5 0  0.5 0.5 0.5  2   0
se  0   0.5 0  0.5 0.5 0.5  6   1
se  1.6 0.5 0  0.5 0.5 0.5 12   2

plane 0 1 0 0 3

light -0.5 -0.7 -0.6  1 1 1 0.9