#ifndef MT_SHIM_TYPE_TRAITS
#define MT_SHIM_TYPE_TRAITS

template <class T> struct __mt_is_pointer_impl { static const bool value = false; };
template <class T> struct __mt_is_pointer_impl<T *> { static const bool value = true; };

template <class T> struct __mt_is_volatile_impl { static const bool value = false; };
template <class T> struct __mt_is_volatile_impl<volatile T> { static const bool value = true; };

template <class T> struct __mt_array_rank_impl { static const unsigned long value = 0; };
template <class T, unsigned long N> struct __mt_array_rank_impl<T[N]>
{
    static const unsigned long value = 1 + __mt_array_rank_impl<T>::value;
};

#define __is_pointer(...)   (__mt_is_pointer_impl<__VA_ARGS__>::value)
#define __is_volatile(...)  (__mt_is_volatile_impl<__VA_ARGS__>::value)
#define __array_rank(...)   (__mt_array_rank_impl<__VA_ARGS__>::value)

#include_next <type_traits>

#endif
